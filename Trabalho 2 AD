# ---------------------------------------------------------------- 7. Factores associados (grupo tratamento) com Holm e Cohen's d
cat("\n== Factores associados (grupo tratamento) ==\n")

t_com_d <- function(formula, dados, nome, niveis = NULL) {
  y <- dados[[all.vars(formula)[1]]]
  g <- factor(dados[[all.vars(formula)[2]]])
  if (is.null(niveis)) niveis <- levels(g)
  a <- y[g == niveis[1]]; b <- y[g == niveis[2]]
  
  tt <- t.test(a, b)                       # Welch; diferença = média(a) - média(b)
  sp <- sqrt(((length(a) - 1) * var(a) + (length(b) - 1) * var(b)) / (length(a) + length(b) - 2))
  
  tibble(factor = nome, contraste = paste(niveis[1], "-", niveis[2]),
         n1 = length(a), n2 = length(b),
         dif = mean(a) - mean(b),
         ic_inf = tt$conf.int[1], ic_sup = tt$conf.int[2],
         t = unname(tt$statistic), gl = unname(tt$parameter), p = tt$p.value,
         d = (mean(a) - mean(b)) / sp)
}

fatores <- bind_rows(
  t_com_d(PERDA ~ GENERO,  trat, "Género"),
  t_com_d(PERDA ~ FUMO2,   trat, "Tabagismo"),
  t_com_d(PERDA ~ MARITAL, trat, "Estado marital",
          niveis = c("Com parceiro(a)", "Sem parceiro(a)"))
) %>%
  mutate(p_holm = p.adjust(p, method = "holm"))

print(fatores %>% mutate(across(where(is.numeric), ~ round(.x, 4))))
