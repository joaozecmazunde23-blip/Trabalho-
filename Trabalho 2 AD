# ---------------------------------------------------------------- 0. Funções auxiliares
## Cohen's d para teste t independente (positivo = primeiro grupo maior)
cohen_d <- function(a, b) {
  sp <- sqrt(((length(a)-1)*var(a) + (length(b)-1)*var(b))/(length(a)+length(b)-2))
  (mean(a) - mean(b))/sp
}

## Eta² para ANOVA
eta2 <- function(anova_obj) {
  ss <- summary(anova_obj)[[1]]$`Sum Sq`
  ss[1]/sum(ss)
}

## IC 95% da média
ci_media <- function(x) {
  m <- mean(x); se <- sd(x)/sqrt(length(x)); q <- qt(.975, length(x) - 1)
  c(m, m - q*se, m + q*se)
}

# ---------------------------------------------------------------- 1. Dados, recodificação e variáveis
bruto <- read_tsv("BasedeDados.txt", show_col_types = FALSE) %>% mutate(across(where(is.character), trimws))

cat("Omissos:", sum(is.na(bruto)), "| Duplicados ID x VISIT:", sum(duplicated(bruto[, c("ID", "VISIT")])), "\n")

d <- bruto %>%
  pivot_wider(id_cols = c(ID, TREAT, AGE, LIVINGSTATUS, SMOKESTATUS, GENDER),
              names_from = VISIT, values_from = WEIGHT) %>%
  rename(IDADE = AGE) %>%
  mutate(
    PERDA  = PRE - POST,
    PCT    = 100 * PERDA / PRE,
    RESP   = as.integer(PCT >= 5),
    TREAT3 = factor(dplyr::recode(TREAT, CONTROL = "Controlo", PLACEBO = "Placebo",
                                  TREATMENT = "Tratamento"), levels = G3),
