# ---------------------------------------------------------------- 4. Teste t emparelhado (pré vs post) com d_z
cat("\n== Teste t pareado (pré vs pós) ==\n")
emparelhado <- function(s, nome) {
  tt <- t.test(s$PRE, s$POST, paired = TRUE)
  tibble(grupo = nome, n = nrow(s), pre = mean(s$PRE), post = mean(s$POST),
         perda = mean(s$PERDA), ic_inf = tt$conf.int[1], ic_sup = tt$conf.int[2],
         t = unname(tt$statistic), gl = unname(tt$parameter), p = tt$p.value,
         d_z = mean(s$PERDA)/sd(s$PERDA))
}
pareado <- bind_rows(
  lapply(G3, function(g) emparelhado(d %>% filter(TREAT3 == g), g)),
  emparelhado(ctrl, "Controlo + placebo")
)
print(pareado %>% mutate(across(where(is.numeric), ~ round(.x, 4))))

